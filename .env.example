# Browser-visible values. Data access still requires correct database policies.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only values. Never bundle these in browser code or commit filled files.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
SUPABASE_STORAGE_BUCKET=bin-evidence
MODEL_API_KEY=YOUR_MODEL_GATEWAY_KEY
TEAM_ACCESS_CODE=YOUR_STRONG_TEAM_ACCESS_CODE
